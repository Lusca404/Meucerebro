<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Meu cérebro</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧠</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=DM+Sans:wght@400;500;600&family=Newsreader:wght@400;500&display=swap" rel="stylesheet">
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore-compat.js"></script>
<style>
:root{--bg:#14111f;--side:#1a1629;--card:#1f1a30;--line:#312a48;--txt:#f0edf9;--mut:#9b93b4;--acc:#8f90ff;--acc2:#6b6cf0;--hot:#ff7a90;--ok:#4fd6a4;--r:14px}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{background:var(--bg);color:var(--txt);font:15px/1.5 "DM Sans",system-ui,sans-serif}
h1,h2,h3,.brand{font-family:"Bricolage Grotesque","DM Sans",sans-serif;letter-spacing:-.02em}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.hide{display:none!important}
.btn{background:var(--acc2);color:#fff;padding:.6rem 1.1rem;border-radius:10px;font-weight:600}
.btn:hover{background:var(--acc)}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--txt)}
.btn.ghost:hover{border-color:var(--acc)}
input,select,textarea{background:#120f1d;border:1px solid var(--line);border-radius:10px;padding:.65rem .8rem;width:100%}
input:focus,select:focus,textarea:focus{border-color:var(--acc);outline:0}
label{display:block;font-size:13px;color:var(--mut);margin:.9rem 0 .3rem}
#login{min-height:100%;display:grid;place-items:center;padding:1.5rem;background:radial-gradient(900px 500px at 15% 0,#2b2160 0,transparent 60%),radial-gradient(700px 500px at 100% 100%,#4a1f46 0,transparent 55%),var(--bg)}
.lbox{width:100%;max-width:380px;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:2rem}
.logo{font-size:46px;line-height:1}
.lbox h1{font-size:34px;margin:.6rem 0 .2rem}
.lbox p{color:var(--mut)}
.lbox .btn{width:100%;margin-top:1.3rem;padding:.75rem}
.err{color:var(--hot);font-size:13px;min-height:1.2em;margin-top:.7rem}
.sw{margin-top:1rem;text-align:center;color:var(--mut);font-size:14px}
.sw button{color:var(--acc);font-weight:600}
#app{display:flex;height:100%}
aside{width:236px;background:var(--side);border-right:1px solid var(--line);padding:1.3rem .9rem;display:flex;flex-direction:column;gap:.2rem;flex-shrink:0}
.brand{font-size:21px;font-weight:800;padding:.2rem .7rem 1.2rem}
.nav{display:flex;align-items:center;gap:.7rem;padding:.6rem .7rem;border-radius:10px;color:var(--mut);text-align:left;width:100%;font-weight:500}
.nav:hover{background:#241e38;color:var(--txt)}
.nav.on{background:var(--acc2);color:#fff}
.nav .n{margin-left:auto;font-size:12px;background:#0003;padding:0 .5rem;border-radius:99px}
.sp{flex:1}
.mini{font-size:13px;color:var(--mut);padding:.45rem .7rem;text-align:left;width:100%;border-radius:8px}
.mini:hover{color:var(--txt);background:#241e38}
main{flex:1;overflow:auto;padding:2rem clamp(1rem,4vw,3rem)}
.top{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.2rem}
.top h2{font-size:32px;line-height:1.1}
.top small{color:var(--mut)}
.chips{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.4rem}
.chip{padding:.35rem .85rem;border:1px solid var(--line);border-radius:99px;color:var(--mut);font-size:14px}
.chip.on{background:var(--txt);color:var(--bg);border-color:var(--txt);font-weight:600}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:1rem;align-items:start}
.card{--c:transparent;background:var(--card);border:1px solid var(--line);border-top:5px solid var(--c);border-radius:var(--r);padding:1.1rem;display:flex;flex-direction:column;gap:.5rem;cursor:pointer;overflow:hidden}
.card.tc{background:color-mix(in srgb,var(--c) 13%,var(--card));border-color:color-mix(in srgb,var(--c) 40%,var(--line));border-top-color:var(--c)}
.card:hover{border-color:var(--acc)}
.card.urgent{box-shadow:0 0 0 1px var(--hot)}
.card h3{font-size:18px;line-height:1.25}
.card p{color:var(--mut);font-size:14px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap}
.card.done h3{text-decoration:line-through;color:var(--mut)}
.card.done{opacity:.65}
.cv{width:calc(100% + 2.2rem);margin:-1.1rem -1.1rem .3rem;height:150px;object-fit:cover;display:block}
.info{font-size:13px;color:var(--mut);display:flex;gap:.8rem}
.tag{font-size:12px;font-weight:600;padding:.1rem .6rem;border-radius:99px}
.tag.hot{background:var(--hot);color:#2a0710}
.tag.ok{background:var(--ok);color:#06281c}
.tags{display:flex;gap:.4rem;flex-wrap:wrap}
.acts{display:flex;gap:.2rem;padding-top:.5rem;border-top:1px solid #ffffff1a;flex-wrap:wrap}
.acts button{font-size:13px;color:var(--mut);padding:.3rem .55rem;border-radius:8px}
.acts button:hover{background:#ffffff14;color:var(--txt)}
.empty{border:1px dashed var(--line);border-radius:var(--r);padding:2.5rem 1rem;text-align:center;color:var(--mut)}
.ed{display:grid;grid-template-columns:260px 1fr;gap:1rem;height:calc(100% - 4.6rem);min-height:420px}
.list{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:auto;padding:.5rem}
.it{display:block;width:100%;text-align:left;padding:.6rem .7rem;border-radius:10px}
.it:hover{background:#2a2342}
.it.on{background:#2f2750}
.it b{display:block;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.it span{font-size:12px;color:var(--mut)}
.page{background:var(--card);border:1px solid var(--line);border-radius:var(--r);display:flex;flex-direction:column;padding:1.2rem 1.5rem;min-height:0}
.page .ttl{background:none;border:0;border-bottom:1px solid var(--line);border-radius:0;font:700 26px "Bricolage Grotesque",sans-serif;padding:.2rem 0 .7rem}
.meta{display:flex;gap:.8rem;align-items:center;margin:.8rem 0;flex-wrap:wrap}
.meta label{margin:0}
.meta select{width:auto;max-width:100%;font-size:14px;padding:.4rem .6rem}
.page textarea{flex:1;background:none;border:0;resize:none;font:19px/1.75 "Newsreader",Georgia,serif;padding:.4rem 0;min-height:240px}
.foot{display:flex;justify-content:space-between;color:var(--mut);font-size:13px;padding-top:.6rem;border-top:1px solid var(--line)}
.foot button{color:var(--hot)}
dialog{background:var(--card);color:var(--txt);border:1px solid var(--line);border-radius:18px;padding:1.5rem;width:min(580px,94vw);max-height:92vh;overflow:auto;margin:auto}
dialog::backdrop{background:#000a}
dialog h3{font-size:22px}
.row{display:flex;gap:.6rem;justify-content:flex-end;margin-top:1.4rem;flex-wrap:wrap}
.chk{display:flex;gap:.5rem;align-items:center;color:var(--txt);font-size:14px;margin:.9rem 1.2rem 0 0}
.chk input{width:auto}
.cols{display:flex;gap:.5rem;flex-wrap:wrap}
.cols button{width:30px;height:30px;border-radius:50%;border:2px solid var(--line)}
.cols button.on{border-color:#fff;box-shadow:0 0 0 2px var(--acc2)}
.inl{display:flex;gap:.5rem}.inl input{flex:1}
.lks{display:flex;flex-direction:column;gap:.3rem;margin-top:.5rem}
.lk{display:flex;justify-content:space-between;gap:.5rem;background:#120f1d;border-radius:8px;padding:.35rem .7rem;font-size:14px}
.lk a{color:var(--acc);text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lk button,.th button{color:var(--hot)}
.ims{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:.5rem;margin-bottom:.5rem}
.th{position:relative}
.th img{width:100%;height:90px;object-fit:cover;border-radius:8px;display:block}
.th button{position:absolute;top:4px;right:4px;background:#000b;border-radius:50%;width:22px;height:22px;line-height:1}
@media(max-width:760px){
 #app{flex-direction:column-reverse}
 aside{width:100%;flex-direction:row;padding:.4rem;border-right:0;border-top:1px solid var(--line);justify-content:space-around}
 .brand,.sp,.mini{display:none}
 .nav{flex-direction:column;gap:0;font-size:12px;padding:.4rem;width:auto}
 .nav .n{display:none}
 main{padding:1.2rem 1rem}
 .ed{grid-template-columns:1fr;height:auto}
 .list{max-height:170px}
 .page{min-height:420px}
}
</style>
</head>
<body>
<section id="login">
 <div class="lbox">
  <div class="logo">🧠</div>
  <h1>Meu cérebro</h1>
  <p id="lsub">Entre para ver suas ideias.</p>
  <label for="u">E-mail</label><input id="u" type="email" autocomplete="username">
  <label for="p">Senha</label><input id="p" type="password" autocomplete="current-password">
  <div class="err" id="err"></div>
  <button class="btn" id="go">Entrar</button>
  <div class="sw"><span id="swt">Primeira vez aqui?</span> <button id="sw">Criar conta</button></div>
 </div>
</section>
<div id="app" class="hide">
 <aside>
  <div class="brand">🧠 Meu cérebro</div>
  <button class="nav" data-tab="reel">🎬 Reels <span class="n" id="n-reel"></span></button>
  <button class="nav" data-tab="post">🖼️ Posts <span class="n" id="n-post"></span></button>
  <button class="nav" data-tab="yt">▶️ YouTube <span class="n" id="n-yt"></span></button>
  <button class="nav" data-tab="scripts">📝 Roteiros <span class="n" id="n-scripts"></span></button>
  <div class="sp"></div>
  <button class="mini" id="exp">Baixar backup</button>
  <button class="mini" id="out">Sair</button>
 </aside>
 <main id="main"></main>
</div>
<dialog id="dlg">
 <h3 id="dt"></h3>
 <label for="f-t">Título</label><input id="f-t" maxlength="140">
 <label>Cor do card</label><div class="cols" id="cols"></div>
 <label for="f-d">Descrição</label><textarea id="f-d" rows="5"></textarea>
 <label for="f-l">Links</label>
 <div class="inl"><input id="f-l" placeholder="Cole um link e tecle Enter"><button class="btn ghost" id="al">Adicionar</button></div>
 <div class="lks" id="lk"></div>
 <label>Imagens</label>
 <div class="ims" id="im"></div>
 <button class="btn ghost" id="ai">+ Adicionar imagens</button><input type="file" id="fi" accept="image/*" multiple class="hide">
 <div><label class="chk" style="display:inline-flex"><input type="checkbox" id="f-u"> Fazer logo</label><label class="chk" style="display:inline-flex"><input type="checkbox" id="f-x"> Feito</label></div>
 <div class="row"><button class="btn ghost" id="dl" style="margin-right:auto;color:var(--hot)">Excluir</button><button class="btn ghost" id="ds">📝 Roteiro</button><button class="btn ghost" id="cx">Cancelar</button><button class="btn" id="sv">Salvar</button></div>
</dialog>

<script>
/* ===== CONFIGURAÇÃO: cole aqui os dados do seu projeto Firebase ===== */
const firebaseConfig={apiKey:'AIzaSyAyMlBpm3vELqO07UqHtoKy1KKg-0bHkZU',authDomain:'meucerebro-364ee.firebaseapp.com',projectId:'meucerebro-364ee',appId:'1:1033312524248:web:bfec4e97c9b529fd2b04ad'};
/* ==================================================================== */
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>'10000000-1000-4000-8000-100000000000'.replace(/[018]/g,c=>(c^crypto.getRandomValues(new Uint8Array(1))[0]&15>>c/4).toString(16));
const TYPES={reel:'Reels',post:'Posts',yt:'Vídeos do YouTube'};
const NEW={reel:'Nova ideia de reel',post:'Nova ideia de post',yt:'Nova ideia de vídeo'};
const COLORS=['','#8f90ff','#ff7a90','#4fd6a4','#ffc857','#5ec8ff','#c792ea','#ff9f5a'];
const configured=!firebaseConfig.apiKey.startsWith('COLE');
let fa=null,fs=null;
if(configured){firebase.initializeApp(firebaseConfig);fa=firebase.auth();fs=firebase.firestore()}
const ERR={'auth/invalid-credential':'E-mail ou senha incorretos.','auth/wrong-password':'E-mail ou senha incorretos.','auth/user-not-found':'E-mail ou senha incorretos.','auth/email-already-in-use':'Esse e-mail já tem conta. Clique em Entrar.','auth/weak-password':'Use uma senha com 6+ caracteres.','auth/invalid-email':'E-mail inválido.','auth/too-many-requests':'Muitas tentativas. Aguarde um pouco.'};
let user=null,db={ideas:[],scripts:[]},tab='reel',filter='all',cur=null,w=null,isNew=false,mode='login';

const fail=e=>{if(e){console.error(e);alert('Não foi possível salvar: '+e.message)}};
const col=n=>fs.collection('users').doc(user.uid).collection(n);
const run=async f=>{try{await f()}catch(e){fail(e)}};
const upd=(t,id,p)=>run(()=>col(t).doc(id).update(p));

/* ---------- login ---------- */
function setMode(m){mode=m;const s=m==='signup';
 $('#go').textContent=s?'Criar conta':'Entrar';
 $('#lsub').textContent=s?'Crie seu acesso para guardar suas ideias.':'Entre para ver suas ideias.';
 $('#swt').textContent=s?'Já tem conta?':'Primeira vez aqui?';
 $('#sw').textContent=s?'Entrar':'Criar conta';$('#err').textContent=''}
$('#sw').onclick=()=>setMode(mode==='login'?'signup':'login');
async function auth(){
 const E=m=>$('#err').textContent=m;
 if(!configured)return E('Falta configurar o Firebase no começo do arquivo index.html.');
 const email=$('#u').value.trim(),password=$('#p').value;
 if(!email||password.length<6)return E('Informe o e-mail e uma senha com 6+ caracteres.');
 try{mode==='signup'?await fa.createUserWithEmailAndPassword(email,password):await fa.signInWithEmailAndPassword(email,password)}
 catch(x){E(ERR[x.code]||x.message)}
}
$('#go').onclick=auth;
$('#p').onkeydown=e=>{if(e.key==='Enter')auth()};
async function start(u){
 user=u;$('#login').classList.add('hide');$('#app').classList.remove('hide');
 $('#main').innerHTML='<div class="empty">Carregando suas ideias…</div>';
 try{const [a,b]=await Promise.all([col('ideas').get(),col('scripts').get()]);
  db.ideas=a.docs.map(d=>({...d.data(),id:d.id,links:d.data().links||[],images:d.data().images||[]}));
  db.scripts=b.docs.map(d=>({...d.data(),id:d.id}))}catch(e){fail(e)}
 render();
}
$('#out').onclick=async()=>{await fa.signOut();location.reload()};

/* ---------- navegação ---------- */
document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;filter='all';render()});
function render(){
 document.querySelectorAll('.nav').forEach(b=>b.classList.toggle('on',b.dataset.tab===tab));
 for(const t in TYPES)$('#n-'+t).textContent=db.ideas.filter(i=>i.type===t&&!i.done).length||'';
 $('#n-scripts').textContent=db.scripts.length||'';
 tab==='scripts'?renderScripts():renderIdeas();
}

/* ---------- ideias ---------- */
function renderIdeas(){
 const all=db.ideas.filter(i=>i.type===tab);
 const F={all:'Todas',todo:'Pendentes',hot:'Fazer logo',done:'Feitas'};
 const l=all.filter(i=>filter==='all'||(filter==='todo'&&!i.done)||(filter==='hot'&&i.urgent&&!i.done)||(filter==='done'&&i.done))
  .sort((a,b)=>(a.done-b.done)||(b.urgent-a.urgent)||b.created_at.localeCompare(a.created_at));
 const pend=all.filter(i=>!i.done).length;
 $('#main').innerHTML=`
 <div class="top"><div><h2>${TYPES[tab]}</h2><small>${pend} pendente${pend===1?'':'s'} · ${all.length} no total</small></div>
 <button class="btn" data-a="new">+ ${NEW[tab]}</button></div>
 <div class="chips">${Object.entries(F).map(([k,v])=>`<button class="chip ${filter===k?'on':''}" data-f="${k}">${v}</button>`).join('')}</div>
 ${l.length?`<div class="grid">${l.map(card).join('')}</div>`:`<div class="empty">${all.length?'Nenhuma ideia neste filtro.':'Nenhuma ideia ainda. Anote a primeira antes que ela escape.'}</div>`}`;
}
function card(i){
 const hasS=db.scripts.some(x=>x.idea_id===i.id);
 return `<article class="card ${i.color?'tc':''} ${i.urgent&&!i.done?'urgent':''} ${i.done?'done':''}" style="--c:${i.color||'transparent'}" data-a="open" data-id="${i.id}">
 ${i.images[0]?`<img class="cv" src="${esc(i.images[0].u)}" loading="lazy" alt="">`:''}
 ${(i.urgent&&!i.done)||i.done?`<div class="tags">${i.urgent&&!i.done?'<span class="tag hot">🔥 Fazer logo</span>':''}${i.done?'<span class="tag ok">Feito</span>':''}</div>`:''}
 <h3>${esc(i.title)}</h3>${i.description?`<p>${esc(i.description)}</p>`:''}
 <div class="info">${i.images.length?`<span>🖼 ${i.images.length}</span>`:''}${i.links.length?`<span>🔗 ${i.links.length}</span>`:''}${hasS?'<span>📝 roteiro</span>':''}</div>
 <div class="acts"><button data-a="done" data-id="${i.id}">${i.done?'↩ Reabrir':'✓ Feito'}</button><button data-a="hot" data-id="${i.id}">${i.urgent?'Tirar urgência':'🔥 Fazer logo'}</button></div></article>`;
}

/* ---------- janela de detalhes ---------- */
function openDlg(i){
 isNew=!i;
 w=i?JSON.parse(JSON.stringify(i)):{id:uid(),type:tab,title:'',description:'',links:[],images:[],color:'',urgent:false,done:false};
 $('#dt').textContent=i?'Detalhes da ideia':NEW[tab];
 $('#f-t').value=w.title;$('#f-d').value=w.description;$('#f-u').checked=w.urgent;$('#f-x').checked=w.done;$('#f-l').value='';
 $('#dl').classList.toggle('hide',isNew);$('#ds').classList.toggle('hide',w.type!=='yt');
 drawAll();$('#dlg').showModal();if(isNew)$('#f-t').focus();
}
function drawAll(){
 $('#cols').innerHTML=COLORS.map(c=>`<button data-c="${c}" class="${w.color===c?'on':''}" title="${c?'Cor':'Sem cor'}" style="background:${c||'repeating-linear-gradient(45deg,#2a2342 0 4px,#14111f 4px 8px)'}"></button>`).join('');
 $('#lk').innerHTML=w.links.map((u,n)=>`<div class="lk"><a href="${esc(u)}" target="_blank" rel="noopener">${esc(u.replace(/^https?:\/\//,''))}</a><button data-rl="${n}" aria-label="Remover link">✕</button></div>`).join('');
 $('#im').innerHTML=w.images.map((m,n)=>`<div class="th"><img data-oi="${n}" style="cursor:zoom-in" src="${esc(m.u)}" alt=""><button data-ri="${n}" aria-label="Remover imagem">✕</button></div>`).join('');
}
$('#cols').onclick=e=>{const b=e.target.closest('[data-c]');if(b){w.color=b.dataset.c;drawAll()}};
$('#lk').onclick=e=>{const b=e.target.closest('[data-rl]');if(b){w.links.splice(+b.dataset.rl,1);drawAll()}};
$('#im').onclick=e=>{const b=e.target.closest('[data-ri]');if(b){w.images.splice(+b.dataset.ri,1);return drawAll()}
 const t=e.target.closest('[data-oi]');if(t){const win=window.open('','_blank');fetch(w.images[+t.dataset.oi].u).then(r=>r.blob()).then(x=>{win.location=URL.createObjectURL(x)})}};
function addLink(){let v=$('#f-l').value.trim();if(!v)return;if(!/^https?:\/\//i.test(v))v='https://'+v;w.links.push(v);$('#f-l').value='';drawAll()}
$('#al').onclick=addLink;
$('#f-l').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();addLink()}};
async function shrink(f){
 const bm=await createImageBitmap(f),k=Math.min(1,900/Math.max(bm.width,bm.height)),c=document.createElement('canvas');
 c.width=Math.round(bm.width*k);c.height=Math.round(bm.height*k);c.getContext('2d').drawImage(bm,0,0,c.width,c.height);
 return c.toDataURL('image/jpeg',.72);
}
$('#ai').onclick=()=>$('#fi').click();
$('#fi').onchange=async e=>{
 $('#ai').textContent='Enviando…';
 for(const f of e.target.files){
  try{w.images.push({u:await shrink(f)});
   if(w.images.reduce((a,m)=>a+m.u.length,0)>850000){w.images.pop();alert('Limite de imagens desta ideia atingido (cerca de 600 KB no total). Remova alguma para adicionar outra.');break}
   drawAll()}
  catch(x){alert('Não foi possível enviar "'+f.name+'": '+(x.message||'formato não suportado'))}
 }
 e.target.value='';$('#ai').textContent='+ Adicionar imagens';
};
async function saveIdea(){
 const t=$('#f-t').value.trim();if(!t){$('#f-t').focus();return null}
 const p={title:t,description:$('#f-d').value,links:w.links,images:w.images,color:w.color,urgent:$('#f-u').checked,done:$('#f-x').checked};
 if(p.done)p.urgent=false;
 if(isNew){const row={id:w.id,type:w.type,...p,created_at:new Date().toISOString()};await run(()=>col('ideas').doc(row.id).set(row));db.ideas.push(row);isNew=false}
 else{Object.assign(db.ideas.find(x=>x.id===w.id),p);await upd('ideas',w.id,p)}
 return w.id;
}
$('#sv').onclick=async()=>{if(await saveIdea()){$('#dlg').close();render()}};
$('#cx').onclick=()=>$('#dlg').close();
$('#dl').onclick=async()=>{
 if(!confirm('Excluir esta ideia e suas imagens? Roteiros vinculados continuam salvos.'))return;
 const i=db.ideas.find(x=>x.id===w.id);
 await run(()=>col('ideas').doc(i.id).delete());
 db.ideas=db.ideas.filter(x=>x.id!==i.id);db.scripts.forEach(s=>{if(s.idea_id===i.id){s.idea_id=null;upd('scripts',s.id,{idea_id:null})}});
 $('#dlg').close();render();
};
$('#ds').onclick=async()=>{const id=await saveIdea();if(!id)return;
 const s=db.scripts.find(x=>x.idea_id===id)||await newScript(id,$('#f-t').value.trim());
 cur=s.id;tab='scripts';$('#dlg').close();render()};

async function newScript(ideaId,title){
 const s={id:uid(),title:title||'Roteiro sem título',body:'',idea_id:ideaId||null,updated_at:new Date().toISOString()};
 await run(()=>col('scripts').doc(s.id).set(s));db.scripts.unshift(s);cur=s.id;return s;
}

/* ---------- cliques no conteúdo ---------- */
$('#main').addEventListener('click',async e=>{
 const f=e.target.closest('[data-f]');if(f){filter=f.dataset.f;return renderIdeas()}
 const b=e.target.closest('[data-a]');if(!b)return;
 const id=b.dataset.id,i=db.ideas.find(x=>x.id===id),a=b.dataset.a;
 if(a==='new')openDlg();
 else if(a==='open')openDlg(i);
 else if(a==='done'){i.done=!i.done;if(i.done)i.urgent=false;render();upd('ideas',id,{done:i.done,urgent:i.urgent})}
 else if(a==='hot'){i.urgent=!i.urgent;render();upd('ideas',id,{urgent:i.urgent})}
 else if(a==='newscript'){await newScript();render()}
 else if(a==='pick'){cur=id;renderScripts()}
 else if(a==='delscript'){if(confirm('Excluir este roteiro?')){const d=cur;db.scripts=db.scripts.filter(x=>x.id!==d);cur=null;render();run(()=>col('scripts').doc(d).delete())}}
});

/* ---------- roteiros ---------- */
const fmt=t=>new Date(t).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'});
function item(x){const i=db.ideas.find(k=>k.id===x.idea_id);
 return `<button class="it ${x.id===cur?'on':''}" data-a="pick" data-id="${x.id}"><b>${esc(x.title)||'Sem título'}</b><span>${i?'▶ '+esc(i.title)+' · ':''}${fmt(x.updated_at)}</span></button>`}
function renderScripts(){
 if(!db.scripts.find(s=>s.id===cur))cur=db.scripts[0]?.id||null;
 const s=db.scripts.find(x=>x.id===cur),yts=db.ideas.filter(i=>i.type==='yt');
 $('#main').innerHTML=`
 <div class="top"><div><h2>Roteiros</h2><small>Escreva aqui e vincule a um vídeo do YouTube.</small></div><button class="btn" data-a="newscript">+ Novo roteiro</button></div>
 <div class="ed"><div class="list" id="sl">${db.scripts.length?db.scripts.map(item).join(''):'<div class="empty" style="border:0">Nenhum roteiro ainda.</div>'}</div>
 ${s?`<div class="page"><input class="ttl" id="st" value="${esc(s.title)}" placeholder="Título do roteiro" aria-label="Título">
  <div class="meta"><label for="sk">Vídeo vinculado</label><select id="sk"><option value="">Sem vínculo</option>${yts.map(i=>`<option value="${i.id}" ${i.id===s.idea_id?'selected':''}>${esc(i.title)}</option>`).join('')}</select></div>
  <textarea id="sb" placeholder="Comece o roteiro: gancho, desenvolvimento, chamada para ação…">${esc(s.body)}</textarea>
  <div class="foot"><span id="wc"></span><span id="ss">Salvo</span><button data-a="delscript">Excluir roteiro</button></div></div>`:'<div class="empty">Crie um roteiro para começar a escrever.</div>'}</div>`;
 if(!s)return;
 const wc=()=>{const n=s.body.trim()?s.body.trim().split(/\s+/).length:0;$('#wc').textContent=n+' palavras · ~'+Math.max(1,Math.round(n/150))+' min de fala'};wc();
 let t;const touch=()=>{s.updated_at=new Date().toISOString();$('#ss').textContent='Salvando…';clearTimeout(t);
  t=setTimeout(async()=>{await upd('scripts',s.id,{title:s.title,body:s.body,idea_id:s.idea_id,updated_at:s.updated_at});$('#ss').textContent='Salvo'},700)};
 $('#sb').oninput=e=>{s.body=e.target.value;wc();touch()};
 $('#st').oninput=e=>{s.title=e.target.value;const el=document.querySelector('.it.on b');if(el)el.textContent=s.title||'Sem título';touch()};
 $('#sk').onchange=e=>{s.idea_id=e.target.value||null;touch();$('#sl').innerHTML=db.scripts.map(item).join('')};
}

/* ---------- backup ---------- */
$('#exp').onclick=()=>{const a=document.createElement('a');
 a.href=URL.createObjectURL(new Blob([JSON.stringify(db,null,1)],{type:'application/json'}));
 a.download='meu-cerebro-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click()};

/* ---------- início ---------- */
if(configured)fa.onAuthStateChanged(u=>{if(u&&!user)start(u)});
else $('#err').textContent='Falta configurar o Firebase no começo do arquivo index.html.';
</script>
</body>
</html>
